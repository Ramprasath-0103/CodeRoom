generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id
  createdAt DateTime @default(now())

  files File[]
}

model File {
  id      String @id
  name    String
  content String

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}
