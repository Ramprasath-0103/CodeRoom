    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hocuspocus/provider": "^4.3.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "supertest": "^7.3.1",
    "vitest": "^4.1.10"
