# Postgres connection string (e.g. Supabase pooler URL)
DATABASE_URL=

# Allowed frontend origin for CORS.
# In production set to your Vercel URL, e.g. https://coderoom.vercel.app
# Leave unset to allow all origins (fine for local dev).
CLIENT_ORIGIN=

# Judge0 CE key from RapidAPI, for the "Run Code" feature.
# Get one at https://rapidapi.com/judge0-official/api/judge0-ce
RAPIDAPI_KEY=

# PORT is injected by the host (Render) automatically. Defaults to 3000 locally.
